{
  "name": "Order",
  "type": "object",
  "properties": {
    "customer_email": {
      "type": "string",
      "format": "email",
      "description": "Email of the customer who placed the order"
    },
    "items": {
      "type": "array",
      "description": "Line items in the order",
      "items": {
        "type": "object",
        "properties": {
          "record_id": { "type": "string" },
          "title": { "type": "string" },
          "artist": { "type": "string" },
          "price": { "type": "number" },
          "quantity": { "type": "integer" }
        }
      }
    },
    "total": {
      "type": "number",
      "description": "Order total in USD",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": ["pending", "paid", "cancelled"],
      "default": "pending",
      "description": "Payment / fulfillment status"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe Checkout Session ID associated with this order"
    }
  },
  "required": ["items", "total"],
  "rls": {
    "create": { "user_condition": { "id": "{{user.id}}" } },
    "read": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
